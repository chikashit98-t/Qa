# cp .env.example .env して値を設定する（.envはGitに入れない）
DOMAIN=example.com
# Cloudflare Tunnelのトークン（ZeroTrust > Networks > Tunnels で発行。秘密情報なのでGitに入れない）
TUNNEL_TOKEN=
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-strong-too
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
